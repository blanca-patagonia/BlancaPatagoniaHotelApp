@startuml
!include _estilo.iuml
left to right direction
actor "Huésped" as HUE
actor "Pasarela\nde pagos" as PAS
actor "Servicio\nde correo" as COR
rectangle "Portal público" {
  usecase "**CU-01**\nReservar desde el portal público" as CU #FFF4D6
  usecase "Consultar disponibilidad\npor tipo de alojamiento" as A
  usecase "Cotizar la estadía\n(tarifa de mostrador con IVA)" as B
  usecase "Registrar al huésped" as C
  usecase "Pagar la seña en línea" as D
  usecase "Enviar la confirmación\npor correo" as E
}
HUE --> CU
CU ..> A : <<include>>
CU ..> B : <<include>>
CU ..> C : <<include>>
D ..> CU : <<extend>>
CU ..> E : <<include>>
D --> PAS
E --> COR
@enduml
