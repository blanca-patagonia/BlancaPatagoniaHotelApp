@startuml
!include _estilo.iuml
left to right direction
actor "Recepción" as REC
rectangle "Consumos" {
  usecase "**CU-03**\nCargar un consumo" as CU #FFF4D6
  usecase "Elegir la estadía\nen curso" as A
  usecase "Verificar que la cuenta\nesté abierta" as B
  usecase "Numerar la comanda" as C
  usecase "Descontar el stock\ndel producto" as D
  usecase "Anular una comanda" as E
}
REC --> CU
CU ..> A : <<include>>
CU ..> B : <<include>>
CU ..> C : <<include>>
CU ..> D : <<include>>
E ..> CU : <<extend>>
@enduml
