actor "Recepción" as REC
actor "Gerencia" as GER
actor "Pasarela\nde pagos" as PAS
actor "Facturación\nelectrónica" as FAC
rectangle "Sistema de Gestión Hotelera — Blanca Patagonia" {
  usecase "CU-01\nReservar desde el portal público" as CU1
  usecase "CU-02\nHacer el check-in" as CU2
  usecase "CU-03\nCargar un consumo" as CU3
  usecase "CU-04\nHacer el check-out\ny emitir la factura" as CU4
