# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno — Sistema de Gestión Hotelera Blanca Patagonia
# Copiar este archivo como `.env.local` y completar con los valores reales.
# `.env.local` NO se versiona (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-o-publishable-key"

# Clave privilegiada (service role / secret). SOLO en el servidor. NUNCA exponer.
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# ── Pagos (Fase 3) ───────────────────────────────────────────────────────────
# MercadoPago — https://www.mercadopago.com.ar/developers
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Email transaccional (Fase 4) ─────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="reservas@blancapatagonia.com"

# ── Selección de proveedor (ADR 0018) ────────────────────────────────────────
# Cada integración externa elige su implementación con una de estas variables.
# En desarrollo se pueden dejar vacías: cae al simulador sin ruido.
# En PRODUCCIÓN son OBLIGATORIAS y el arranque falla si faltan o están mal
# escritas (`lib/integraciones/seleccion.ts`). Quedarse con el simulador es
# válido, pero hay que declararlo con el nombre del simulador, nunca por
# descuido: el de facturación emite un CAE inventado sobre una factura real.
EMAIL_PROVIDER=""         # simulador: "consola"  (escribe el correo en el log)
FIRMA_PROVIDER=""         # simulador: "local"    (sin validez legal)
FACTURACION_PROVIDER=""   # simulador: "simulado" (CAE simulado, NO es AFIP)
COTIZACION_PROVIDER=""    # respaldo:  "manual"   (usa la cotización que cargó un admin)
CANAL_PROVIDER=""         # simulador: "simulado" (no habla con ninguna OTA)

# `PAGO_PROVIDER` es el ÚNICO que admite varios separados por coma, porque el
# hotel ofrece varios medios a la vez: `mercadopago,stripe`. Stripe cubre la
# tarjeta internacional y MercadoPago los pesos, las cuotas y el efectivo.
# Simulador: "simulado". Con pasarelas reales van las credenciales de arriba.
PAGO_PROVIDER=""

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Sincronización automática de canales ────────────────────────────────────
# Secreto que autoriza a `/api/cron/canales`, el único endpoint que escribe en la
# base SIN sesión de usuario (corre con `service_role`, que saltea RLS).
#
# ⚠️ Si falta, el handler RECHAZA todo. No hay modo "sin secreto": eso lo
# convertiría en un endpoint público que escribe en la base, y el fallo sería
# silencioso justo en producción. Mismo criterio que el ADR 0018.
#
# Generar uno largo y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
