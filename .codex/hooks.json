            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/mbackhaus/Desktop/BLANCA/.codex/hooks/al-iniciar.mjs'",
