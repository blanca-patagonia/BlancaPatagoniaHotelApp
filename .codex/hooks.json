          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/mbackhaus/Desktop/BLANCA/.codex/hooks/al-terminar.mjs'",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
