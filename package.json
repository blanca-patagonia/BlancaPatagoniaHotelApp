{
  "name": "blanca-patagonia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dominio": "vitest run tests/dominio",
    "test:servicios": "vitest run tests/servicios",
    "test:acciones": "vitest run tests/acciones",
    "test:contratos": "vitest run tests/contratos",
    "test:componentes": "vitest run tests/componentes",
    "test:db": "vitest run tests/base-de-datos",
    "test:aislado": "node scripts/tests-aislados.mjs",
    "test:aislado:parar": "supabase stop --workdir supabase-tests",
    "esquema:comparar": "node scripts/comparar-esquema.mjs",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "setup": "npm ci && node --env-file-if-exists=.env.local scripts/setup.mjs",
    "seed:usuarios": "node --env-file-if-exists=.env.local scripts/seed-usuarios.mjs",
    "integraciones": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings scripts/verificar-integraciones.mjs",
    "configurar": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings scripts/configurar-integraciones.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.108.1",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^26.1.0",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "browserslist": "^4.28.8"
  }
}
