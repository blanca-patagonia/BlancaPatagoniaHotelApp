# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase (artefactos locales del CLI)
supabase/.branches
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# Artefactos de la verificación con navegador (Playwright MCP).
.playwright-mcp/

# Videos originales (masters de edición). Pesan cientos de MB —el institucional
# en .mov ronda los 550 MB— y GitHub rechaza todo archivo de más de 100 MB, así
# que un commit que los incluya hace fallar el push entero. El sitio usa la
# versión comprimida (`public/hotel/videos/blanca-hero.mp4`); el master se
# guarda fuera del repositorio.
public/hotel/videos/*.mov
