# Estilo base para cualquier editor. El formato fino (comillas, punto y coma)
# está en `.prettierrc.json`.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Dos espacios al final de una línea son un salto de línea en Markdown.
trim_trailing_whitespace = false
